# Basetract AI Configuration Template
# このファイルを config/.env にリネームし、自身のAPIキーを入力してください。
# 生成コマンド: cp config/secrets.template.env config/.env

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Flask サーバー設定（必須）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Flask セッションの署名キー（必須・起動前に必ず設定してください）
# 生成コマンド: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here

# Basetract ローカル API キー（省略可: 未設定時は認証スキップ）
# 設定すると /api/* エンドポイントに X-Basetract-Key ヘッダーが必要になります
BASETRACT_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI API キー（任意: 使用する AI サービスのみ設定）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# OpenAI API Key (例: sk-...)  ← OCR Vision API, GPT-4 解析に使用
OPENAI_API_KEY=your_key_here

# Anthropic API Key (例: sk-ant-...)
ANTHROPIC_API_KEY=your_key_here

# Google Gemini API Key  ← config.json の model_name: "gemini-2.0-flash" に対応
GOOGLE_API_KEY=your_key_here
